# Скопируйте в .env.local (для npm run dev) или .env.production.local (для npm run build).
# Файлы *.local не попадают в git.

# mock — тестовые данные из кода, sheets — Google Sheets. По умолчанию mock.
VITE_DATA_SOURCE=sheets

# Google Sheets → Файл → Поделиться → Опубликовать в интернете → лист → «CSV».
VITE_PRODUCTS_CSV_URL=https://docs.google.com/spreadsheets/d/e/XXXX/pub?gid=0&single=true&output=csv
VITE_SOLUTIONS_CSV_URL=https://docs.google.com/spreadsheets/d/e/XXXX/pub?gid=1&single=true&output=csv
