# Скопируйте в .env.local (для npm run dev) или .env.production.local (для npm run build).
# Файлы *.local не попадают в git.

# mock — тестовые данные из кода, sheets — Google Sheets и фото с Google Диска. По умолчанию mock.
VITE_DATA_SOURCE=sheets

# ID таблицы из её адреса: docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SHEET_ID=XXXX
# ID корневой папки с фото из её адреса: drive.google.com/drive/folders/<ID>
GOOGLE_PHOTOS_FOLDER_ID=XXXX
# Ключ сервисного аккаунта Google: путь к JSON-файлу (локально) или JSON целиком (на GitHub — секрет)
GOOGLE_SERVICE_ACCOUNT_KEY=./google-key.json
